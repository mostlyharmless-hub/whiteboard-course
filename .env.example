# LLM 供应商：anthropic | openai-compatible
LLM_PROVIDER=openai-compatible

# 型号。anthropic 留空默认 claude-opus-5；openai-compatible 必填（阿里云示例：qwen3.8-max）
LLM_MODEL=qwen3.8-max

# openai-compatible 的接口地址（到 /v1 为止）；anthropic 留空
# 阿里云 OpenAI 兼容模式示例：https://<你的端点>/compatible-mode/v1
LLM_BASE_URL=

LLM_API_KEY=

# openai-compatible 单次请求超时（毫秒），默认 300000；带推理的模型一节可能要 3 分钟以上
LLM_TIMEOUT_MS=

# TTS（阿里云 DashScope 原生接口，到 /api/v1 为止）；留空时由 LLM_BASE_URL 的 /compatible-mode/v1 推导；TTS_API_KEY 留空复用 LLM_API_KEY
TTS_BASE_URL=
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Ethan
TTS_API_KEY=
